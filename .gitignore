# Dependencies and build output
node_modules/
dist/
target/

# Local settings and secrets
.env
.env.*
*.local
*.pem
*.key
*.p12
*.pfx
.claude/settings.local.json

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# Logs
npm-debug.log*

# This repository is public. Documents, drawings, models and images never go in by accident:
# all of these file types are ignored everywhere except in the folders listed further down.
# Put your own test files into samples/private/, which is never committed.
*.pdf
*.doc
*.docx
*.docm
*.dot
*.dotx
*.xls
*.xlsx
*.xlsm
*.xlsb
*.csv
*.ppt
*.pptx
*.pptm
*.odt
*.ods
*.odp
*.rtf
*.msg
*.eml
*.pst
*.dwg
*.dxf
*.dwf
*.dgn
*.step
*.stp
*.iges
*.igs
*.sat
*.x_t
*.sldprt
*.sldasm
*.slddrw
*.ipt
*.iam
*.idw
*.catpart
*.catproduct
*.prt
*.asm
*.stl
*.3mf
*.obj
*.ply
*.glb
*.gltf
*.fbx
*.ifc
*.nc
*.gcode
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
