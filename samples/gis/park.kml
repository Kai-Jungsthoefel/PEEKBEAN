        <name>Boat rental</name>
        <ExtendedData><Data name="category"><value>sport</value></Data><Data name="capacity"><value>12</value></Data></ExtendedData>
        <styleUrl>#poi</styleUrl>
        <Point><coordinates>11.5918868,48.157151,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Information board</name>
        <ExtendedData><Data name="category"><value>info</value></Data><Data name="capacity"><value></value></Data></ExtendedData>
        <styleUrl>#poi</styleUrl>
        <Point><coordinates>11.5897359,48.1586799,0</coordinates></Point>
      </Placemark>
